---
import sanitizeHtml from 'sanitize-html'

import Layout from '../layouts/Layout.astro';
const pageTitle = "Home";

import { get } from '../lib/microcms.ts';
const post = await get("news");
---

<Layout pageTitle={pageTitle} noContentClass={true}>
	<div class="content" set:html={sanitizeHtml(post.content)}/>
</Layout>
