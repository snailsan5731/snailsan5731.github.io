---
import type { Tag } from "../lib/microcms.ts";

interface Props { tags: Tag[]; };
const { tags } = Astro.props;
---

<ul class="linked-tags">
    {
        tags.map((tag: Tag) => (
            <a href={"/tags/" + tag.id}>
                <li>{tag.name}</li>
            </a>
        ))
    }
</ul>