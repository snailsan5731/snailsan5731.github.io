---
import type { Link } from "../lib/microcms.ts";

interface Props { links: Link[]; };
const { links } = Astro.props;
---

{
    links.map((link: Link) => (
        <div class="link">
            <img src={link.icon.url}/>
            <div class="link-description">
                <a href={link.url}>
                    <h2>{link.name}</h2>
                </a>
                <p>{link.description}</p>
            </div>
        </div>
    ))
}